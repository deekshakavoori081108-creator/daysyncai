{
    "compilerOptions":  {
                            "target":  "ES2022",
                            "module":  "ESNext",
                            "moduleResolution":  "Bundler",
                            "esModuleInterop":  true,
                            "allowSyntheticDefaultImports":  true,
                            "strict":  false,
                            "skipLibCheck":  true,
                            "noEmit":  true,
                            "resolveJsonModule":  true,
                            "allowJs":  true,
                            "types":  [
                                          "node"
                                      ],
                            "allowImportingTsExtensions":  true
                        },
    "include":  [
                    "server/**/*.ts",
                    "shared/**/*.ts",
                    "api/**/*.ts"
                ],
    "exclude":  [
                    "node_modules",
                    "dist",
                    "client"
                ]
}
